# RS Creator 1.0 — environment placeholders. Copy to .env and fill in real values.
# NEVER commit a real .env. No real keys are stored in this repo.

# Owner / Super Admin (sole admin of RS Creator)
OWNER_EMAIL=razzshares@gmail.com

# Supabase (create a project at https://supabase.com/dashboard first)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Used by Edge Functions only — never put the service-role key in frontend code.

# AI providers (Edge Function secrets — set via `supabase secrets set`)
# Admin-managed fallback keys; users may also bring their own (BYOK).
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Web dashboard
VITE_APP_URL=http://localhost:5173
